{
    "name": "tuupke/laravel-swagger",
    "description": "Swagger implementation for laravel",
    "type": "library",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": ">=8.2",
        "zircote/swagger-php": "^6.3.1"
    },
    "authors": [
        {
            "name": "Mart Pluijmaekers",
            "email": "mart@tuupke.nl"
        }
    ],
    "autoload": {
        "psr-4": {
            "Tuupke\\Swagger\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Tuupke\\Swagger\\SwaggerServiceProvider"
            ]
        }
    }
}
